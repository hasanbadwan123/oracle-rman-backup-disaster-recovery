# Oracle 11g RMAN backup and media-recovery workflow
# Review file numbers and paths before running in an isolated lab.

CONFIGURE DEFAULT DEVICE TYPE TO DISK;
CONFIGURE DEVICE TYPE DISK BACKUP TYPE TO BACKUPSET;
CONFIGURE CONTROLFILE AUTOBACKUP ON;
CONFIGURE RETENTION POLICY TO RECOVERY WINDOW OF 7 DAYS;
SHOW ALL;

BACKUP DATABASE PLUS ARCHIVELOG;
BACKUP SPFILE;
BACKUP CURRENT CONTROLFILE;

LIST BACKUP SUMMARY;
LIST BACKUP OF DATAFILE 6;
RESTORE DATABASE VALIDATE;

SQL 'ALTER SYSTEM ARCHIVE LOG CURRENT';
BACKUP ARCHIVELOG ALL;
LIST BACKUP OF ARCHIVELOG ALL;

# After simulating loss of datafile 6 and starting the database in MOUNT mode:
RESTORE DATAFILE 6;
RECOVER DATAFILE 6;
SQL 'ALTER DATABASE OPEN';

# Control-file-loss contingency (not executed in the report scenario):
# SET DBID <YOUR_DBID>;
# STARTUP NOMOUNT;
# RESTORE CONTROLFILE FROM AUTOBACKUP;
# ALTER DATABASE MOUNT;

